{
  "name": "example-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "oxfmt --write \"**/*.{ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "test:ahp": "pnpm --filter @experiments/ahp-conformance test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260819.1",
    "@types/node": "26.6.3",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2003",
    "oxfmt": "0.71.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
