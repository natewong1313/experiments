{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@experiments/oxlint-config/base.json"],
  "rules": {
    "zod/consistent-object-schema-type": ["error", { "allow": ["strictObject"] }],
    "unicorn/max-nested-calls": "off",
    "oxc/no-barrel-file": "off"
  },
  "overrides": [
    {
      "files": ["src/acp/**"],
      "rules": {
        "zod/consistent-object-schema-type": ["error", { "allow": ["strictObject", "looseObject"] }]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "eslint/no-magic-numbers": "off"
      }
    }
  ]
}
