{
  "name": "@experiments/agent-host-example-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "generate-routes": "tsr generate",
    "check-types": "tsr generate && wrangler types --include-runtime=false --strict-vars=false && tsc --noEmit",
    "lint": "oxlint --deny-warnings --type-aware src vite.config.ts"
  },
  "dependencies": {
    "@experiments/agent-host": "workspace:*",
    "@experiments/pi-agent": "workspace:*",
    "@experiments/protocol-schemas": "workspace:*",
    "@fontsource-variable/outfit": "^5.3.0",
    "@microsoft/agent-host-protocol": "catalog:",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@experiments/oxlint-config": "workspace:*",
    "@experiments/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.40",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.0"
  }
}
