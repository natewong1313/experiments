{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-host-web",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_NAME": "Agent Host Web",
    "WORKSPACE_DIR": "/workspace",
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentHostRoot", "AgentHostSession", "AgentHostConnectionRouter"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_HOST",
        "class_name": "AgentHostRoot",
      },
      {
        "name": "AGENT_SESSION",
        "class_name": "AgentHostSession",
      },
      {
        "name": "AGENT_ROUTER",
        "class_name": "AgentHostConnectionRouter",
      },
    ],
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
}
