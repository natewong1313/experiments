{
  "name": "@experiments/agent-host-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "check-types": "wrangler types --include-runtime=false --strict-vars=false && tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "lint": "oxlint --deny-warnings --type-aware src client",
    "prompt": "node --experimental-strip-types client/prompt.ts"
  },
  "dependencies": {
    "@experiments/agent-host": "workspace:*",
    "@experiments/pi-agent": "workspace:*",
    "@microsoft/agent-host-protocol": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@experiments/oxlint-config": "workspace:*",
    "@experiments/typescript-config": "workspace:*"
  }
}
