{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACP_URL": "",
    "WORKSPACE_DIR": "/workspace"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_HOST",
        "class_name": "AgentHost"
      },
      {
        "name": "PI_AGENT",
        "class_name": "PiAgent"
      }
    ]
  },
  "exports": {
    "AgentHost": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PiAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ]
}
