{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "observability": { "enabled": true },
  "vars": { "ACP_URL": "", "WORKSPACE_DIR": "/workspace" },
  "containers": [
    {
      "class_name": "HarnessContainer",
      "image": "../../../harness-container/Dockerfile",
      "image_build_context": "../../../harness-container",
      "instance_type": "basic",
      "max_instances": 5,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_HOST", "class_name": "AgentHost" },
      {
        "name": "HARNESS_CONTAINER",
        "class_name": "HarnessContainer",
      },
    ],
  },
  "exports": {
    "AgentHost": { "type": "durable-object", "storage": "sqlite" },
    "HarnessContainer": { "type": "durable-object", "storage": "sqlite" },
  },
  "secrets": {
    "required": ["CLOUDFLARE_API_KEY", "CLOUDFLARE_ACCOUNT_ID"],
  },
}
