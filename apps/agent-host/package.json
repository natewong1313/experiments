{
  "name": "@experiments/agent-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:generate": "drizzle-kit generate --config src/host/db/drizzle.config.ts && drizzle-kit generate --config src/session/db/drizzle.config.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint --deny-warnings --type-aware src test vitest.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@experiments/protocol-schemas": "workspace:*",
    "@microsoft/agent-host-protocol": "catalog:",
    "drizzle-orm": "^0.45.3",
    "durability": "^3.0.1",
    "durable-utils": "^0.3.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@experiments/oxlint-config": "workspace:*",
    "@experiments/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11"
  },
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/helpers/index.ts"
  }
}
