{
  "name": "@experiments/harness-container",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:bridge": "node --experimental-strip-types --env-file=.env container/main.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false",
    "check-types": "wrangler types --include-runtime=false && tsc --noEmit",
    "lint": "oxlint --deny-warnings --type-aware .",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test test/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.26.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260819.1",
    "@experiments/oxlint-config": "workspace:*",
    "@experiments/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  }
}
