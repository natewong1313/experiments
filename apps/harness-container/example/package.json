    "@experiments/scripts": "workspace:*",
    "@experiments/typescript-config": "workspace:*",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  }
}
